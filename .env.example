# Server
PORT=5000
NODE_ENV=development

# Database (we will configure this in the next step)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/house_management?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-at-least-32-chars
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12